{
  "close": "Fechar",
  "theme": "abismo",
  "column": [
    {
      "row": [
        {
          "column": [
            { "text": "MISSÕES", "style": "titulo" },
            { "row": [ { "text": "{resumo}", "style": "good" }, { "text": "{renova}", "style": "muted" } ], "gap": 6 }
          ],
          "gap": 3, "w": "grow"
        },
        { "button": "", "icon": "ui:abismo/fechar", "look": "fechar", "onClick": { "action": "close" }, "tooltip": "Fechar", "w": 18 }
      ],
      "w": "grow", "cross": "start"
    },
    {
      "repeat": "ativa", "perPage": 1,
      "column": [
        { "text": "{rotulo}", "style": "destaque" },
        {
          "row": [
            { "icon": "{icone}", "size": 32, "frame": true },
            {
              "column": [
                { "row": [ { "text": "{texto}", "style": "heading", "w": "grow" }, { "text": "{xp}", "style": "ouro" } ], "w": "grow" },
                { "text": "{requisito}", "style": "muted", "w": "grow" },
                {
                  "row": [
                    { "progress": "{barra}", "max": "100", "track": "ui:mare/progress_track", "fill": "ui:mare/progress_fill", "w": 180 },
                    { "text": "{situacao}", "style": "accent", "w": "grow", "align": "right" }
                  ],
                  "w": "grow", "cross": "center", "gap": 6
                }
              ],
              "gap": 4, "w": "grow"
            }
          ],
          "gap": 7, "pad": 7, "surface": "painel", "w": "grow", "cross": "center"
        }
      ],
      "gap": 3, "w": "grow"
    },
    {
      "repeat": "aviso", "perPage": 1,
      "row": [ { "text": "{texto}", "style": "{estilo}", "w": "grow", "align": "center" } ],
      "pad": 7, "surface": "painel", "w": "grow"
    },
    {
      "repeat": "titulo_diarias", "perPage": 1,
      "text": "DIÁRIAS DE HOJE", "style": "heading"
    },
    {
      "repeat": "diarias", "perPage": 3,
      "row": [
        { "icon": "{icone}", "size": 16, "frame": true },
        {
          "column": [
            { "text": "{texto}", "style": "body", "w": "grow" },
            { "row": [ { "text": "{situacao}", "style": "{situacao_estilo}" }, { "text": "{xp}", "style": "ouro" } ], "gap": 6 }
          ],
          "gap": 3, "w": "grow"
        },
        { "button": "{acao}", "look": "acao", "bind": "escolher", "disabled": "{bloqueado}", "w": 62, "tooltip": "{dica}" }
      ],
      "gap": 7, "pad": 5, "surface": "painel", "w": "grow", "cross": "center"
    }
  ],
  "gap": 4, "pad": 8, "surface": "moldura", "w": 320
}
