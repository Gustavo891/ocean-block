{
  "theme": "reino",
  "footer": false,
  "column": [
    {
      "row": [
        {
          "column": [
            { "text": "MISSÕES", "style": "titulo" },
            { "row": [ { "text": "{resumo}", "style": "good" }, { "text": "{diarias_feitas}", "style": "muted" } ], "gap": 4 }
          ],
          "gap": 3, "w": "grow"
        },
        { "row": [ { "text": "{renova}", "style": "ouro" } ], "pad": 5, "surface": "faixa" },
        { "button": "", "icon": "ui:abismo/fechar", "look": "fechar", "onClick": { "action": "close" }, "tooltip": "Fechar", "w": 18 }
      ],
      "w": "grow", "cross": "center", "gap": 5
    },
    { "image": "ui:reino/separador", "w": 386 },
    {
      "row": [
        {
          "column": [
            { "text": "DIÁRIAS DE HOJE", "style": "muted" },
            {
              "repeat": "aviso", "perPage": 1,
              "row": [ { "text": "{texto}", "style": "{estilo}", "w": "grow", "align": "center" } ],
              "pad": 6, "surface": "faixa", "w": "grow"
            },
            {
              "repeat": "diarias", "perPage": 3,
              "column": [
                {
                  "row": [
                    { "space": 1 },
                    { "icon": "{icone}", "size": 16 },
                    {
                      "column": [
                        { "row": [ { "text": "{texto}", "style": "body", "w": "grow" }, { "text": "{xp}", "style": "{xp_estilo}" } ], "w": "grow", "gap": 4 },
                        {
                          "x": 0, "y": 7,
                          "row": [
                            { "progress": "{barra}", "max": "100", "track": "ui:reino/barra_trilho", "fill": "ui:reino/barra", "w": "grow" },
                            { "text": "{contagem}", "style": "{contagem_estilo}" }
                          ],
                          "w": "grow", "cross": "center", "gap": 4
                        }
                      ],
                      "w": "grow"
                    }
                  ],
                  "w": "grow", "h": 26, "pad": 3, "gap": 4, "cross": "center", "surface": "faixa"
                },
                { "row": [ { "icon": "{faixa}", "size": 26 } ], "x": 0, "y": 0 },
                { "row": [ { "button": "", "look": "selecao", "bind": "selecionar", "selected": "{selecionada}", "tooltip": "{dica}", "w": 196 } ], "x": 0, "y": 0 }
              ],
              "w": 196
            },
            {
              "repeat": "legenda", "perPage": 1,
              "row": [
                { "icon": "ui:reino/legenda_laranja", "size": 3 }, { "text": "SELECIONADA", "style": "muted" },
                { "space": 3 },
                { "icon": "ui:reino/legenda_azul", "size": 3 }, { "text": "VALENDO", "style": "muted" },
                { "space": 3 },
                { "icon": "ui:reino/legenda_verde", "size": 3 }, { "text": "FEITA", "style": "muted" }
              ],
              "gap": 3, "cross": "center"
            },
            {
              "x": 0, "y": 134,
              "box": [
                { "button": "", "look": "selecao", "bind": "trilha", "tooltip": "Ver a trilha", "w": 196 },
                {
                  "row": [
                    { "text": "TRILHA", "style": "body" },
                    { "row": [], "w": 2, "h": 1 },
                    { "progress": "{trilha_barra}", "max": "100", "track": "ui:reino/barra_trilho", "fill": "ui:reino/barra", "w": "grow" },
                    { "text": "{trilha}", "style": "{trilha_estilo}" },
                    { "icon": "ui:reino/seta", "size": 7 }
                  ],
                  "w": 196, "h": 26, "pad": 6, "gap": 3, "cross": "center", "surface": "cartao"
                }
              ],
              "w": 196
            }
          ],
          "gap": 4, "w": 196, "h": 160
        },
        {
          "column": [
            {
              "repeat": "detalhe", "perPage": 1,
              "column": [
                {
                  "row": [
                    { "icon": "{icone}", "size": 24, "frame": true },
                    {
                      "column": [
                        { "text": "{titulo}", "style": "heading", "w": "grow" },
                        { "text": "{requisito}", "style": "claro", "w": "grow", "wrap": true }
                      ],
                      "gap": 4, "w": "grow"
                    }
                  ],
                  "gap": 6, "w": "grow", "cross": "center"
                },
                {
                  "row": [
                    { "progress": "{barra}", "max": "100", "track": "ui:reino/barra_grande_trilho", "fill": "ui:reino/barra_grande", "w": "grow" },
                    { "text": "{progresso}", "style": "branco" }
                  ],
                  "w": "grow", "cross": "center", "gap": 4
                }
              ],
              "gap": 6, "w": "grow"
            },
            { "image": "ui:reino/separador", "w": 170 },
            { "text": "RECOMPENSAS", "style": "muted" },
            {
              "repeat": "recompensas", "perPage": 3,
              "row": [
                { "icon": "{icone}", "size": 8 },
                { "text": "{nome}", "style": "claro", "w": "grow" },
                { "text": "{valor}", "style": "{valor_estilo}" }
              ],
              "w": "grow", "pad": 3, "gap": 4, "cross": "center", "surface": "faixa"
            },
            { "text": "{nota}", "style": "nota", "w": "grow" },
            { "row": [ { "button": "{botao}", "look": "claro", "bind": "escolher", "disabled": "{bloqueado}", "tooltip": "{dica}", "w": 170 } ], "x": 7, "y": 135 }
          ],
          "gap": 5, "pad": 7, "surface": "cartao", "w": "grow", "h": 160
        }
      ],
      "gap": 6, "w": "grow"
    }
  ],
  "gap": 5, "pad": 7, "surface": "moldura", "w": 400, "canCloseWithEscape": true
}
