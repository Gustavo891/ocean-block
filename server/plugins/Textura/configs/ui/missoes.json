            { "text": "{nota}", "style": "nota", "w": "grow" },
            { "row": [ { "button": "{botao}", "look": "acao", "bind": "escolher", "disabled": "{bloqueado}", "tooltip": "{dica}", "w": 174 } ], "x": 7, "y": 151 }
          ],
          "gap": 5, "pad": 7, "surface": "painel", "w": "grow", "h": 176
        }
      ],
      "gap": 6, "w": "grow"
    }
  ],
  "gap": 5, "pad": 7, "surface": "moldura", "w": 380
}
