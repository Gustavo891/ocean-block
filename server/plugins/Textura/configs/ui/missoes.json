          ],
          "gap": 4, "w": "grow"
        },
        { "row": [ { "text": "{renova}", "style": "ouro" } ], "pad": 5, "surface": "pilula" },
        { "button": "X", "look": "fechar", "onClick": { "action": "close" }, "tooltip": "Fechar", "w": 18 }
      ],
      "w": "grow", "cross": "center", "gap": 5
    },
    { "image": "ui:abismo/separador", "w": 366 },
    {
      "row": [
        {
          "column": [
            { "text": "DIÁRIAS DE HOJE", "style": "muted" },
