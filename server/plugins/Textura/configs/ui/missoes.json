                        { "row": [ { "text": "{texto}", "style": "body", "w": "grow" }, { "text": "{xp}", "style": "{xp_estilo}" } ], "w": "grow" },
                        {
                          "row": [
                            { "progress": "{barra}", "max": "100", "track": "ui:abismo/barra_trilho", "fill": "ui:abismo/barra", "w": 84 },
                            { "text": "{contagem}", "style": "{contagem_estilo}", "w": "grow", "align": "right" }
                          ],
                          "w": "grow", "cross": "center", "gap": 4
                        }
                      ],
                      "gap": 4, "w": "grow"
                    }
                  ],
                  "w": "grow", "h": 26, "pad": 4, "gap": 4, "cross": "center", "surface": "cartao"
                },
                { "row": [ { "icon": "{faixa}", "size": 26 } ], "x": 0, "y": 0 },
                { "row": [ { "button": "", "look": "selecao", "bind": "selecionar", "selected": "{selecionada}", "tooltip": "{dica}", "w": 172 } ], "x": 0, "y": 0 }
              ],
              "w": 172
            },
            {
              "repeat": "legenda", "perPage": 1,
              "row": [
                { "icon": "ui:abismo/legenda_laranja", "size": 3 }, { "text": "SELECIONADA", "style": "muted" },
                { "space": 3 },
                { "icon": "ui:abismo/legenda_azul", "size": 3 }, { "text": "VALENDO AGORA", "style": "muted" },
                { "space": 3 },
                { "icon": "ui:abismo/legenda_verde", "size": 3 }, { "text": "FEITA", "style": "muted" }
              ],
              "gap": 2, "cross": "center"
            },
            {
              "x": 0, "y": 158,
              "box": [
                { "button": "", "look": "neutro", "bind": "trilha", "tooltip": "Ver a trilha", "w": 172 },
                {
                  "row": [
                    { "icon": "item:nether_star", "size": 10 },
                    { "text": "TRILHA", "style": "button", "w": "grow" },
                    { "text": "{trilha}", "style": "trilha" }
                  ],
                  "w": 172, "h": 18, "pad": 5, "gap": 5, "cross": "center"
                }
              ],
              "w": 172
            }
          ],
          "gap": 4, "w": 172, "h": 176
        },
        {
          "repeat": "detalhe", "perPage": 1,
          "column": [
            {
              "row": [
                { "icon": "{icone}", "size": 28, "frame": true },
                {
                  "column": [
                    { "text": "{titulo}", "style": "heading", "w": "grow" },
                    { "text": "{subtitulo}", "style": "{subtitulo_estilo}", "w": "grow" }
                  ],
                  "gap": 5, "w": "grow"
                }
              ],
              "gap": 6, "w": "grow", "cross": "center"
            },
            { "image": "ui:abismo/separador", "w": 174 },
            { "text": "REQUISITO", "style": "muted" },
            { "text": "{requisito}", "style": "body", "w": "grow" },
