{
  "theme": "reino",
  "footer": false,
  "column": [
    {
      "row": [
        {
          "column": [
            { "text": "TRILHA", "style": "titulo" },
            { "row": [ { "text": "{resumo}", "style": "good" }, { "text": "{xp}", "style": "muted" } ], "gap": 4 }
          ],
          "gap": 3, "w": "grow"
        },
        { "button": "", "icon": "ui:abismo/fechar", "look": "fechar", "onClick": { "action": "close" }, "tooltip": "Fechar", "w": 18 }
      ],
      "w": "grow", "cross": "center", "gap": 5
    },
    { "image": "ui:reino/separador", "w": 386 },
    {
      "row": [
        {
          "column": [
            { "text": "CAMINHO DO MAR", "style": "muted" },
            { "space": 2 },
            {
              "row": [
                {
                  "repeat": "fileira1", "perPage": 5,
                  "row": [
                    {
                      "box": [
                        { "row": [ { "icon": "{icone}", "size": 16 } ], "w": 24, "h": 24, "pad": 4, "surface": "faixa" },
                        { "icon": "{estado}", "size": 24 },
                        { "icon": "{selo}", "size": 24 },
                        { "button": "", "look": "no_trilha", "bind": "ver1", "selected": "{selecionada}", "tooltip": "{dica}", "w": 24 }
                      ],
                      "w": 24
                    },
                    { "icon": "{liga}", "size": 19 }
                  ],
                  "cross": "center"
                }
              ]
            },
            { "repeat": "desce1", "perPage": 1, "row": [ { "row": [], "w": 172, "h": 1 }, { "icon": "{liga}", "size": 6 } ] },
            {
              "row": [
                {
                  "repeat": "fileira2", "perPage": 5,
                  "row": [
                    {
                      "box": [
                        { "row": [ { "icon": "{icone}", "size": 16 } ], "w": 24, "h": 24, "pad": 4, "surface": "faixa" },
                        { "icon": "{estado}", "size": 24 },
                        { "icon": "{selo}", "size": 24 },
                        { "button": "", "look": "no_trilha", "bind": "ver2", "selected": "{selecionada}", "tooltip": "{dica}", "w": 24 }
                      ],
                      "w": 24
                    },
                    { "icon": "{liga}", "size": 19 }
                  ],
                  "cross": "center"
                }
              ]
            },
            { "repeat": "desce2", "perPage": 1, "row": [ { "icon": "{liga}", "size": 6 } ] },
            {
              "row": [
                {
                  "repeat": "fileira3", "perPage": 5,
                  "row": [
                    {
                      "box": [
                        { "row": [ { "icon": "{icone}", "size": 16 } ], "w": 24, "h": 24, "pad": 4, "surface": "faixa" },
                        { "icon": "{estado}", "size": 24 },
                        { "icon": "{selo}", "size": 24 },
                        { "button": "", "look": "no_trilha", "bind": "ver3", "selected": "{selecionada}", "tooltip": "{dica}", "w": 24 }
                      ],
                      "w": 24
                    },
                    { "icon": "{liga}", "size": 19 }
                  ],
                  "cross": "center"
                }
              ]
            },
            { "space": 4 },
            {
              "row": [
                { "icon": "ui:reino/legenda_verde", "size": 3 }, { "text": "FEITA", "style": "muted" },
                { "space": 4 },
                { "icon": "ui:reino/legenda_amarela", "size": 3 }, { "text": "AGORA", "style": "muted" },
                { "space": 4 },
                { "icon": "ui:reino/legenda_cinza", "size": 3 }, { "text": "PRÓXIMA", "style": "muted" }
              ],
              "gap": 3, "cross": "center"
            },
            {
              "x": 0, "y": 134,
              "box": [
                { "button": "", "look": "selecao", "bind": "diarias", "tooltip": "Ver as diárias", "w": 196 },
                {
                  "row": [
                    {
                      "column": [ { "text": "DIÁRIAS DE HOJE", "style": "body" }, { "text": "{renova}", "style": "ouro" } ],
                      "gap": 1, "w": "grow"
                    },
                    { "repeat": "mini", "perPage": 3, "row": [ { "icon": "{icone}", "size": 16 } ] },
                    { "text": "{diarias_estado}", "style": "{diarias_estilo}" },
                    { "icon": "ui:reino/seta", "size": 7 }
                  ],
                  "w": 196, "h": 26, "pad": 5, "gap": 4, "cross": "center", "surface": "faixa"
                }
              ],
              "w": 196
            }
          ],
          "w": 196, "h": 160
        },
        {
          "column": [
            {
              "repeat": "detalhe", "perPage": 1,
              "column": [
                {
                  "row": [
                    { "icon": "{icone}", "size": 24, "frame": true },
                    {
                      "column": [
                        { "text": "{titulo}", "style": "heading", "w": "grow" },
                        { "text": "{requisito}", "style": "claro", "w": "grow", "wrap": true }
                      ],
                      "gap": 4, "w": "grow"
                    }
                  ],
                  "gap": 6, "w": "grow", "cross": "center"
                },
                {
                  "row": [
                    { "progress": "{barra}", "max": "100", "track": "ui:reino/barra_grande_trilho", "fill": "ui:reino/barra_grande", "w": "grow" },
                    { "text": "{progresso}", "style": "branco" }
                  ],
                  "w": "grow", "cross": "center", "gap": 4
                }
              ],
              "gap": 6, "w": "grow"
            },
            { "image": "ui:reino/separador", "w": 170 },
            { "text": "RECOMPENSAS", "style": "muted" },
            {
              "repeat": "recompensas", "perPage": 3,
              "row": [
                { "icon": "{icone}", "size": 8 },
                { "text": "{nome}", "style": "claro", "w": "grow" },
                { "text": "{valor}", "style": "{valor_estilo}" }
              ],
              "w": "grow", "pad": 3, "gap": 4, "cross": "center", "surface": "faixa"
            },
            { "text": "{nota}", "style": "nota", "w": "grow" },
            { "row": [ { "button": "{botao}", "look": "claro", "bind": "escolher", "disabled": "{bloqueado}", "tooltip": "{dica}", "w": 170 } ], "x": 7, "y": 135 }
          ],
          "gap": 5, "pad": 7, "surface": "cartao", "w": "grow", "h": 160
        }
      ],
      "gap": 6, "w": "grow"
    }
  ],
  "gap": 5, "pad": 7, "surface": "moldura", "w": 400, "canCloseWithEscape": true
}
