{
  "title": "Fornalha elétrica",
  "close": "Fechar",
  "theme": "maquina",
  "column": [
    {
      "column": [
        {
          "row": [
            { "space": 4 },
            { "text": "Fornalha Elétrica", "style": "heading", "align": "left", "icon": "ui:fornalha_item", "w": "grow" },
            { "text": "{estado}", "style": "{estado_estilo}", "align": "right", "w": "fit" },
            { "space": 4 }
          ],
          "w": "grow", "h": 15, "gap": 3, "pad": 0, "align": "start", "cross": "center", "surface": "head", "name": "Cabecalho"
        },
        {
          "column": [
            {
              "row": [
                { "text": "{status}", "style": "body", "align": "left", "w": "grow" },
                { "text": "{gasto}", "style": "muted", "align": "right", "w": "fit" }
              ],
              "w": "grow", "h": "fit", "gap": 6, "pad": 0, "align": "start", "cross": "center", "name": "Resumo"
            },
            {
              "column": [
                {
                  "repeat": "fila", "perPage": 4,
                  "row": [
                    {
                      "slots": [1, 1], "bind": "devolver",
                      "items": [{ "at": 0, "item": "{in}", "count": "{in_qtd}", "name": "{in_nome}", "lore": ["{info}", "Clique para devolver."] }]
                    },
                    {
                      "column": [
                        { "text": "{nome}", "style": "body", "align": "left", "w": 190 },
                        { "progress": "{prog}", "max": "50", "track": "ui:maquina/progress_track", "fill": "ui:maquina/progress_fill", "w": 190 }
                      ],
                      "w": "grow", "h": "fit", "gap": 2, "pad": 0, "align": "start", "cross": "start"
                    },
                    {
                      "slots": [1, 1], "bind": "recolher",
                      "items": [{ "at": 0, "item": "{out}", "count": "{out_qtd}", "name": "{out_nome}", "lore": ["Pronto.", "Clique para recolher."] }]
                    }
                  ],
                  "w": "grow", "h": "fit", "gap": 6, "pad": 2, "align": "start", "cross": "center", "surface": "well", "name": "Linha"
                }
              ],
              "w": "grow", "h": "fit", "gap": 2, "pad": 0, "align": "start", "cross": "start", "name": "Fila"
            },
            { "button": "Recolher tudo", "bind": "recolher_tudo", "look": "light", "w": "grow", "disabled": "{sem_saida}", "tooltip": "Recolher tudo\n\nOs itens prontos vão para o seu inventário." }
          ],
          "w": "grow", "h": "fit", "gap": 5, "pad": 5, "align": "start", "cross": "start", "name": "Corpo"
        }
      ],
      "w": 260, "h": "fit", "gap": 0, "pad": 1, "align": "start", "cross": "start", "surface": "sheet", "name": "Fornalha"
    },
    {
      "column": [
        {
          "row": [
            { "space": 4 },
            { "text": "Seu inventário", "style": "heading", "align": "left", "w": "grow" },
            { "text": "Clique para derreter", "style": "muted", "align": "right", "w": "fit" },
            { "space": 4 }
          ],
          "w": "grow", "h": 15, "gap": 3, "pad": 0, "align": "start", "cross": "center", "surface": "head", "name": "Cabecalho"
        },
        {
          "column": [
            {
              "grid": [
                {
                  "repeat": "inventario", "perPage": 27,
                  "slots": [1, 1], "bind": "colocar",
                  "items": [{ "at": 0, "item": "{item}", "count": "{qtd}", "name": "{nome}", "lore": ["{dica}"], "missing": "{nao}" }]
                }
              ],
              "columns": 9, "w": "fit", "h": "fit", "gap": 0, "pad": 0, "align": "start", "cross": "start", "name": "Mochila"
            },
            {
              "grid": [
                {
                  "repeat": "hotbar", "perPage": 9,
                  "slots": [1, 1], "bind": "colocar_barra",
                  "items": [{ "at": 0, "item": "{item}", "count": "{qtd}", "name": "{nome}", "lore": ["{dica}"], "missing": "{nao}" }]
                }
              ],
              "columns": 9, "w": "fit", "h": "fit", "gap": 0, "pad": 0, "align": "start", "cross": "start", "name": "Barra"
            }
          ],
          "w": "grow", "h": "fit", "gap": 4, "pad": 5, "align": "start", "cross": "center", "name": "Corpo"
        }
      ],
      "w": 260, "h": "fit", "gap": 0, "pad": 1, "align": "start", "cross": "start", "surface": "sheet", "name": "Inventario"
    }
  ],
  "w": "fit", "h": "fit", "gap": 8, "pad": 0, "align": "start", "cross": "start"
}
