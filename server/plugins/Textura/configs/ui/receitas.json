{
  "row": [
    {
      "column": [
        {
          "repeat": "categorias",
          "perPage": 6,
          "nav": "{nome}",
          "icon": "{icone}",
          "bind": "categoria",
          "selected": "{ativa}",
          "w": "grow",
          "tooltip": "{nome}\n{descricao}\n\n{acao}"
        }
      ],
      "w": 96,
      "h": "fit",
      "gap": 1,
      "pad": 2,
      "align": "start",
      "cross": "start",
      "surface": "sheet",
      "name": "Categorias"
    },
    {
      "column": [
        {
          "column": [
            {
              "row": [
                {
                  "space": 3
                },
                {
                  "text": "{titulo}",
                  "style": "heading",
                  "align": "left",
                  "scale": 1,
                  "icon": "{titulo_icone}",
                  "w": "grow"
                },
                {
                  "space": 2
                }
              ],
              "w": "grow",
              "h": 15,
              "gap": 3,
              "pad": 0,
              "align": "start",
              "cross": "center",
              "surface": "head",
              "name": "Heading"
            },
            {
              "column": [
                {
                  "grid": [
                    {
                      "repeat": "receitas",
                      "perPage": 6,
                      "column": [
                        {
                          "slots": [
                            1,
                            1
                          ],
                          "items": [
                            {
                              "at": 0,
                              "item": "{item}",
                              "count": "{qtd}",
                              "name": "{nome}",
                              "lore": [
                                "{descricao}"
                              ]
                            }
                          ],
                          "align": "center"
                        },
                        {
                          "text": "{nome}",
                          "style": "heading",
                          "align": "left",
                          "scale": 1,
                          "w": "fit"
                        },
                        {
                          "text": "{custo}",
                          "style": "body",
                          "align": "left",
                          "scale": 1,
                          "w": "fit"
                        },
                        {
                          "button": "Craftar",
                          "icon": "ui:cart",
                          "look": "light",
                          "bind": "craftar",
                          "disabled": "{falta}",
                          "w": "grow",
                          "tooltip": "{nome}\n{descricao}\n\nCusto\n{custo_lista}\n\n{acao}"
                        }
                      ],
                      "w": "grow",
                      "h": "fit",
                      "gap": 3,
                      "pad": 5,
                      "align": "start",
                      "cross": "center",
                      "surface": "well"
                    }
                  ],
                  "w": "grow",
                  "h": "fit",
                  "gap": 4,
                  "pad": 0,
                  "align": "center",
                  "cross": "center",
                  "columns": 2,
                  "name": "Cards"
                },
                {
                  "repeat": "paginacao",
                  "perPage": 1,
                  "row": [
                    {
                      "button": "«",
                      "look": "light",
                      "bind": "anterior",
                      "disabled": "{sem_anterior}",
                      "w": 24,
                      "tooltip": "Página anterior"
                    },
                    {
                      "text": "{pagina}/{paginas}",
                      "style": "body",
                      "align": "center",
                      "scale": 1,
                      "w": "grow"
                    },
                    {
                      "button": "»",
                      "look": "light",
                      "bind": "proxima",
                      "disabled": "{sem_proxima}",
                      "w": 24,
                      "tooltip": "Próxima página"
                    }
                  ],
                  "w": "grow",
                  "h": "fit",
                  "gap": 4,
                  "pad": 0,
                  "align": "start",
                  "cross": "center",
                  "name": "Paginas"
                },
                {
                  "text": "Os itens vão para o seu inventário.",
                  "style": "muted",
                  "align": "left",
                  "scale": 1,
                  "w": "fit"
                }
              ],
              "w": "grow",
              "h": "fit",
              "gap": 9,
              "pad": 5,
              "align": "start",
              "cross": "start",
              "name": "Body"
            }
          ],
          "w": "grow",
          "h": "fit",
          "gap": 0,
          "pad": 1,
          "align": "start",
          "cross": "start",
          "surface": "sheet",
          "name": "Receitas"
        }
      ],
      "w": "grow",
      "h": "fit",
      "gap": 6,
      "pad": 0,
      "align": "start",
      "cross": "start"
    }
  ],
  "w": "fit",
  "h": "fit",
  "gap": 8,
  "pad": 0,
  "align": "start",
  "cross": "start",
  "title": "Receitas",
  "theme": "stone"
}
