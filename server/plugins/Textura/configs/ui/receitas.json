{
  "row": [
    {
      "column": [
        {
          "text": "Categorias",
          "style": "heading",
          "align": "left",
          "scale": 1,
          "w": "fit"
        },
        {
          "repeat": "categorias",
          "perPage": 6,
          "nav": "{nome}",
          "icon": "{icone}",
          "bind": "categoria",
          "selected": "{ativa}",
          "w": "grow",
          "tooltip": "{nome}\n{descricao}\n\n{acao}"
        }
      ],
      "w": 90,
      "h": "fit",
      "gap": 2,
      "pad": 2,
      "align": "start",
      "cross": "start",
      "surface": "sheet",
      "name": "Categorias"
    },
    {
      "column": [
        {
          "grid": [
            {
              "repeat": "receitas",
              "perPage": 4,
              "column": [
                {
                  "row": [
                    {
                      "icon": "item:{item}",
                      "size": 16
                    },
                    {
                      "column": [
                        {
                          "text": "{nome}",
                          "style": "heading",
                          "align": "left",
                          "scale": 1,
                          "w": "grow",
                          "tooltip": "{nome}\n{descricao}"
                        },
                        {
                          "text": "Rende {rende}",
                          "style": "accent",
                          "align": "left",
                          "scale": 1,
                          "w": "grow"
                        }
                      ],
                      "w": "grow",
                      "h": "fit",
                      "gap": 2,
                      "pad": 0,
                      "align": "start",
                      "cross": "start"
                    }
                  ],
                  "w": "grow",
                  "h": "fit",
                  "gap": 2,
                  "pad": 0,
                  "align": "start",
                  "cross": "center",
                  "name": "Item"
                },
                {
                  "column": [
                    {
                      "slots": [
                        5,
                        1
                      ],
                      "hideEmpty": true,
                      "items": [
                        {
                          "at": 0,
                          "item": "{i0_item}",
                          "count": "{i0_qtd}",
                          "name": "<white>{i0_nome}",
                          "lore": [
                            "{i0_tem}"
                          ],
                          "missing": "{i0_falta}"
                        },
                        {
                          "at": 1,
                          "item": "{i1_item}",
                          "count": "{i1_qtd}",
                          "name": "<white>{i1_nome}",
                          "lore": [
                            "{i1_tem}"
                          ],
                          "missing": "{i1_falta}"
                        },
                        {
                          "at": 2,
                          "item": "{i2_item}",
                          "count": "{i2_qtd}",
                          "name": "<white>{i2_nome}",
                          "lore": [
                            "{i2_tem}"
                          ],
                          "missing": "{i2_falta}"
                        },
                        {
                          "at": 3,
                          "item": "{i3_item}",
                          "count": "{i3_qtd}",
                          "name": "<white>{i3_nome}",
                          "lore": [
                            "{i3_tem}"
                          ],
                          "missing": "{i3_falta}"
                        },
                        {
                          "at": 4,
                          "item": "{i4_item}",
                          "count": "{i4_qtd}",
                          "name": "<white>{i4_nome}",
                          "lore": [
                            "{i4_tem}"
                          ],
                          "missing": "{i4_falta}"
                        }
                      ],
                      "align": "center"
                    },
                    {
                      "row": [
                        {
                          "text": "{status}",
                          "style": "{status_estilo}",
                          "align": "left",
                          "scale": 1,
                          "icon": "{status_icone}",
                          "w": "grow"
                        }
                      ],
                      "w": "grow",
                      "h": 10,
                      "gap": 0,
                      "pad": 0,
                      "align": "start",
                      "cross": "center",
                      "name": "Status"
                    }
                  ],
                  "w": "grow",
                  "h": "fit",
                  "gap": 3,
                  "pad": 4,
                  "align": "start",
                  "cross": "start",
                  "surface": "well",
                  "name": "Ingredientes"
                },
                {
                  "button": "Craftar",
                  "icon": "ui:cart",
                  "look": "craft",
                  "bind": "craftar",
                  "disabled": "{falta}",
                  "w": "grow",
                  "tooltip": "{nome}\n{descricao}\n\nCusto\n{custo_lista}\n\n{acao}"
                }
              ],
              "w": "grow",
              "h": "fit",
              "gap": 5,
              "pad": 4,
              "align": "start",
              "cross": "start",
              "surface": "sheet",
              "name": "Card"
            }
          ],
          "w": "grow",
          "h": "fit",
          "gap": 2,
          "pad": 0,
          "align": "center",
          "cross": "start",
          "columns": 2,
          "name": "Cards"
        },
        {
          "repeat": "paginacao",
          "perPage": 1,
          "row": [
            {
              "button": "«",
              "look": "light",
              "bind": "anterior",
              "disabled": "{sem_anterior}",
              "w": 24,
              "tooltip": "Página anterior"
            },
            {
              "text": "{pagina}/{paginas}",
              "style": "body",
              "align": "center",
              "scale": 1,
              "w": "grow"
            },
            {
              "button": "»",
              "look": "light",
              "bind": "proxima",
              "disabled": "{sem_proxima}",
              "w": 24,
              "tooltip": "Próxima página"
            }
          ],
          "w": "grow",
          "h": "fit",
          "gap": 4,
          "pad": 0,
          "align": "start",
          "cross": "center",
          "name": "Paginas"
        }
      ],
      "w": "grow",
      "h": "fit",
      "gap": 6,
      "pad": 0,
      "align": "start",
      "cross": "start"
    }
  ],
  "w": "fit",
  "h": "fit",
  "gap": 4,
  "pad": 0,
  "align": "start",
  "cross": "start",
  "title": "Receitas",
  "theme": "stone"
}
