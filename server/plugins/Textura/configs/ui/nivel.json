{
  "title": "Seu nível",
  "close": "Fechar",
  "theme": "mare",
  "column": [
    {
      "row": [
        {
          "column": [
            {
              "row": [
                { "space": 4 },
                { "text": "{nivel}", "style": "heading", "align": "left", "icon": "item:experience_bottle", "w": "grow" },
                { "text": "{pct}", "style": "accent", "align": "right", "w": "fit" },
                { "space": 4 }
              ],
              "w": "grow", "h": 15, "gap": 3, "pad": 0, "align": "start", "cross": "center", "surface": "head", "name": "Cabecalho"
            },
            {
              "column": [
                { "progress": "{barra}", "max": "100", "track": "ui:mare/progress_track", "fill": "ui:mare/progress_fill", "w": 184 },
                { "text": "{xp}", "style": "body", "align": "left", "w": "grow" },
                { "text": "{prox}", "style": "muted", "align": "left", "w": "grow" }
              ],
              "w": "grow", "h": "fit", "gap": 4, "pad": 5, "align": "start", "cross": "start", "name": "Corpo"
            }
          ],
          "w": 196, "h": "grow", "gap": 0, "pad": 1, "align": "start", "cross": "start", "surface": "sheet", "name": "Nivel"
        },
        {
          "column": [
            {
              "row": [
                { "space": 4 },
                { "text": "Como ganhar XP", "style": "heading", "align": "left", "w": "grow" },
                { "space": 4 }
              ],
              "w": "grow", "h": 15, "gap": 3, "pad": 0, "align": "start", "cross": "center", "surface": "head", "name": "Cabecalho"
            },
            {
              "column": [
                {
                  "repeat": "fontes", "perPage": 3,
                  "text": "{texto}", "style": "body", "align": "left", "icon": "item:{icone}", "w": "grow", "tooltip": "{texto}\n\n{dica}"
                },
                { "text": "Missões: veja /missoes", "style": "accent", "align": "left", "w": "grow" }
              ],
              "w": "grow", "h": "fit", "gap": 3, "pad": 5, "align": "start", "cross": "start", "name": "Fontes"
            }
          ],
          "w": 196, "h": "grow", "gap": 0, "pad": 1, "align": "start", "cross": "start", "surface": "sheet", "name": "Ganhar"
        }
      ],
      "w": "fit", "h": "fit", "gap": 7, "pad": 0, "align": "start", "cross": "start", "name": "Topo"
    },
    {
      "column": [
        {
          "row": [
            { "space": 4 },
            { "text": "Receitas", "style": "heading", "align": "left", "w": "grow" },
            { "text": "{liberadas}", "style": "muted", "align": "right", "w": "fit" },
            { "space": 4 }
          ],
          "w": "grow", "h": 15, "gap": 3, "pad": 0, "align": "start", "cross": "center", "surface": "head", "name": "Cabecalho"
        },
        {
          "column": [
            {
              "grid": [
                {
                  "repeat": "receitas", "perPage": 10,
                  "row": [
                    {
                      "slots": [1, 1],
                      "items": [{ "at": 0, "item": "{item}", "count": "1", "name": "{nome}", "lore": ["{nivel}", "", "{estado}"], "missing": "{bloqueada}" }]
                    },
                    {
                      "column": [
                        { "text": "{nome}", "style": "body", "align": "left", "w": 166 },
                        {
                          "row": [
                            { "text": "{nivel}", "style": "muted", "align": "left", "w": 52 },
                            { "text": "{situacao}", "style": "{estado_estilo}", "align": "left", "w": "fit" }
                          ],
                          "w": "fit", "h": "fit", "gap": 4, "pad": 0, "align": "start", "cross": "center"
                        }
                      ],
                      "w": "grow", "h": "fit", "gap": 1, "pad": 0, "align": "start", "cross": "start"
                    }
                  ],
                  "w": 192, "h": "fit", "gap": 3, "pad": 1, "align": "start", "cross": "center", "surface": "well", "name": "Receita"
                }
              ],
              "columns": 2, "w": "grow", "h": "fit", "gap": 2, "pad": 0, "align": "start", "cross": "start", "name": "Lista"
            },
            {
              "row": [
                { "button": "<", "bind": "anterior", "look": "light", "w": 24, "disabled": "{sem_anterior}", "tooltip": "Página anterior" },
                { "space": "grow" },
                { "text": "{pagina}", "style": "body", "align": "center", "w": 120 },
                { "space": "grow" },
                { "button": ">", "bind": "proxima", "look": "light", "w": 24, "disabled": "{sem_proxima}", "tooltip": "Próxima página" }
              ],
              "w": "grow", "h": "fit", "gap": 0, "pad": 0, "align": "start", "cross": "center", "name": "Paginas"
            }
          ],
          "w": "grow", "h": "fit", "gap": 4, "pad": 5, "align": "start", "cross": "start", "name": "Corpo"
        }
      ],
      "w": 399, "h": "fit", "gap": 0, "pad": 1, "align": "start", "cross": "start", "surface": "sheet", "name": "Receitas"
    }
  ],
  "w": "fit", "h": "fit", "gap": 8, "pad": 0, "align": "start", "cross": "start"
}
